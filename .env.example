# Variables de seat-inventory-service con valores de QA LOCAL (no son secretos reales).
# Uso: cp .env.example .env   (el .env nunca se sube a git). En PROD los secretos viven solo en el servidor.

# --- Servicio ---
SERVER_PORT=18003

# --- PostgreSQL propia de seat-inventory (en Docker el compose cambia host/puerto a seat-inventory-db:5432) ---
DB_HOST=localhost
DB_PORT=18103
DB_NAME=tripbus_inventory
DB_USERNAME=inventory
DB_PASSWORD=inventory_qa_pw

# --- Redis compartido, con contraseña (en Docker: redis:6379) ---
REDIS_HOST=localhost
REDIS_PORT=18100
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- Token entre servicios (/internal/**) ---
INTERNAL_API_TOKEN=tripbus_internal_qa_token

# --- Otros servicios (en Docker el compose los cambia a host.docker.internal) ---
IDENTITY_JWKS_URI=http://localhost:18001/.well-known/jwks.json
CATALOG_URL=http://localhost:18002

# --- Reglas del inventario ---
# Duración de la retención de asientos (US-022: 10 minutos).
HOLD_TTL=10m
