<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.tripbus</groupId>
    <artifactId>seat-inventory-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>seat-inventory-service</name>
    <description>Inventario de asientos de TripBus: estados, retenciones con TTL, bloqueos distribuidos y confirmación de venta</description>

    <properties>
        <java.version>21</java.version>

        <!-- Parches de seguridad (Trivy) más nuevos que los que gestiona Boot 3.5.16, dentro de las
             mismas líneas menores. Quitarlos cuando una Boot 3.5.x posterior ya los traiga. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.60</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>

        <springdoc.version>2.8.17</springdoc.version>
        <logstash-logback.version>8.0</logstash-logback.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!-- Mínimos de cobertura total que exige jacoco:check (ver jacoco-maven-plugin).
             La cobertura nunca puede bajar: si agregas pruebas, sube el mínimo.
             Fijados con la medición del 2026-10-24 (Sprint 3, US-151/US-139/US-112) redondeada hacia abajo
             al 5 %: líneas 86,6 % -> 0.85; ramas 73,5 % -> 0.70. -->
        <jacoco.minimo.lineas>0.85</jacoco.minimo.lineas>
        <jacoco.minimo.ramas>0.70</jacoco.minimo.ramas>

        <!-- SonarQube Cloud: el análisis lo lanza el CI solo en develop (push y PR con base develop)
             cuando existe el secreto SONAR_TOKEN. El plan Free analiza una única rama. -->
        <sonar.organization>trip-bus</sonar.organization>
        <sonar.projectKey>Trip-Bus_seat-inventory-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Fuera de la cobertura solo lo que no tiene lógica que probar (se sigue analizando como código):
             arranque de Spring, records de entrada/salida sin métodos (todo web/dto), entidades JPA de
             solo constructor/getters (SeatAuditLog, ProcessedEvent) y la definición del documento OpenAPI.
             Se quedan DENTRO porque tienen lógica: domain/Hold, domain/SeatState y domain/KnownItinerary
             (transiciones de estado), config/InventoryProperties (valores por defecto y tope de la
             extensión) y todos los servicios, controladores y seguridad.
             MISMA lista en <excludes> de jacoco-maven-plugin (formato .class; SeatStatesResponse* cubre
             también su record anidado Resumen). -->
        <sonar.coverage.exclusions>
            **/SeatInventoryApplication.java,
            **/web/dto/AvailabilityResponse.java,
            **/web/dto/BlockSeatsRequest.java,
            **/web/dto/BlockSeatsResponse.java,
            **/web/dto/ConfirmSaleRequest.java,
            **/web/dto/HoldRequest.java,
            **/web/dto/HoldResponse.java,
            **/web/dto/InternalHoldRequest.java,
            **/web/dto/OfferSeatsRequest.java,
            **/web/dto/OfferSeatsResponse.java,
            **/web/dto/ReleaseRequest.java,
            **/web/dto/RemapSeatsRequest.java,
            **/web/dto/RemapSeatsResponse.java,
            **/web/dto/SeatStatesResponse.java,
            **/web/dto/SeatView.java,
            **/web/dto/SwapSeatRequest.java,
            **/web/dto/SwapSeatResponse.java,
            **/web/dto/UnblockSeatsRequest.java,
            **/web/dto/VoidSaleRequest.java,
            **/web/dto/VoidSaleResponse.java,
            **/domain/SeatAuditLog.java,
            **/common/events/ProcessedEvent.java,
            **/config/OpenApiConfig.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Swagger UI / OpenAPI (solo IDE y QA; apagado en application-prod.yml). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Logs en JSON en PROD (logback-spring.xml). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de integración contra PostgreSQL y Redis reales (SeatConcurrencyIT, Testcontainers). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Esperas asíncronas en las pruebas del outbox (versión gestionada por Spring Boot). -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Versión fija del scanner que invoca el CI (mvn ... sonar-maven-plugin:sonar). -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties: versión y fecha en /actuator/info. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Unitarias (*Test, *Tests) e integración (*IT, Testcontainers: requiere Docker). -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Cobertura: target/site/jacoco/index.html (y jacoco.xml para Sonar).
                 Además jacoco:check (fase verify) corre en TODAS las ramas, también en main donde no
                 corre Sonar: rompe el build si la cobertura total baja de jacoco.minimo.lineas/ramas.
                 La cobertura nunca puede bajar: si agregas pruebas, sube el mínimo. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- Mismas exclusiones que sonar.coverage.exclusions, para que el % coincida. -->
                    <excludes>
                        <exclude>**/SeatInventoryApplication.class</exclude>
                        <exclude>**/web/dto/AvailabilityResponse.class</exclude>
                        <exclude>**/web/dto/BlockSeatsRequest.class</exclude>
                        <exclude>**/web/dto/BlockSeatsResponse.class</exclude>
                        <exclude>**/web/dto/ConfirmSaleRequest.class</exclude>
                        <exclude>**/web/dto/HoldRequest.class</exclude>
                        <exclude>**/web/dto/HoldResponse.class</exclude>
                        <exclude>**/web/dto/InternalHoldRequest.class</exclude>
                        <exclude>**/web/dto/OfferSeatsRequest.class</exclude>
                        <exclude>**/web/dto/OfferSeatsResponse.class</exclude>
                        <exclude>**/web/dto/ReleaseRequest.class</exclude>
                        <exclude>**/web/dto/RemapSeatsRequest.class</exclude>
                        <exclude>**/web/dto/RemapSeatsResponse.class</exclude>
                        <exclude>**/web/dto/SeatStatesResponse*.class</exclude>
                        <exclude>**/web/dto/SeatView.class</exclude>
                        <exclude>**/web/dto/SwapSeatRequest.class</exclude>
                        <exclude>**/web/dto/SwapSeatResponse.class</exclude>
                        <exclude>**/web/dto/UnblockSeatsRequest.class</exclude>
                        <exclude>**/web/dto/VoidSaleRequest.class</exclude>
                        <exclude>**/web/dto/VoidSaleResponse.class</exclude>
                        <exclude>**/domain/SeatAuditLog.class</exclude>
                        <exclude>**/common/events/ProcessedEvent.class</exclude>
                        <exclude>**/config/OpenApiConfig.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimo.lineas}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimo.ramas}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
